<%- include('partials/header', { title }) %>
<div class="page-head"><div><span class="eyebrow">Administración</span><h1>Promociones</h1></div></div>
<form method="post" action="/promociones" class="panel stack"><h2>Crear promoción</h2>
<label>Nombre<input name="name" maxlength="100" required></label><label>Descuento (%)<input name="percent" type="number" min="1" max="100" step="1" required></label>
<label>Desde<input name="starts_on" type="date" value="<%= today %>" required></label><label>Hasta<input name="ends_on" type="date" value="<%= today %>" required></label>
<fieldset><legend>Productos participantes</legend><div class="searchbar"><input id="promotion-search" type="search" placeholder="Buscar por código o nombre" aria-label="Buscar productos para la promoción" autocomplete="off"><button id="promotion-search-button" type="button" class="btn">Buscar</button></div><p id="promotion-selection" class="muted" role="status" aria-live="polite"></p><div class="promotion-products" id="promotion-products"><% products.forEach(p => { %><label class="check-product promotion-product" data-search="<%= p.code %> <%= p.name %>"><input type="checkbox" name="products" value="<%= p.id %>"><img src="/productos/<%= p.id %>/imagen" alt="" loading="lazy"><span><strong><%= p.name %></strong><small class="muted"><%= p.code %> · <%= money(p.price_cents) %></small></span></label><% }) %></div><p id="promotion-empty" class="empty" hidden>No se encontraron productos. Prueba otro código o nombre.</p></fieldset>
<p class="muted">Se aplica automáticamente el mayor descuento activo por producto. Las fechas incluyen ambos días.</p><button class="btn primary">Guardar promoción</button></form>
<section class="panel"><h2>Promociones registradas</h2><table><thead><tr><th>Nombre</th><th>Descuento</th><th>Vigencia</th><th>Estado</th><th>Acción</th></tr></thead><tbody><% promotions.forEach(p => { %><tr><td><%= p.name %></td><td><%= p.percent %>%</td><td><%= p.starts_on %> al <%= p.ends_on %></td><td><%= p.active ? 'Habilitada' : 'Desactivada' %></td><td><form method="post" action="/promociones/<%= p.id %>/estado"><button class="btn ghost small"><%= p.active ? 'Desactivar' : 'Activar' %></button></form></td></tr><% }) %></tbody></table></section>
<script src="/js/promotions.js"></script>
<%- include('partials/footer') %>
